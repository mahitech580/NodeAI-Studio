# NodeAI Studio v2.5.0
# Copy to .env for local development. Never commit secrets.
AI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
PORT=3000
NODE_ENV=development

# Local development origins. Use exact origins, comma-separated.
CORS_ORIGIN=http://localhost:3000
# On Render set CORS_ORIGIN to:
# https://mahitech580.github.io,https://nodeai-studio-api-mahitech580.onrender.com
# Set true behind Render's proxy; keep false for direct local development.
TRUST_PROXY=false
