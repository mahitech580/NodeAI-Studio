# NodeAI Studio v2.1
# Copy to .env for local development. Never commit secrets.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
PORT=3000
NODE_ENV=development

# Optional exact frontend origins, comma-separated.
# CORS_ORIGIN=https://mahitech580.github.io

# Optional writable path for server-side history.
# HISTORY_FILE=/var/data/nodeai-history.json
